# grandMA3 connection
MA3_HOST=127.0.0.1
MA3_PORT=8000

# Audio playback device (leave empty to use system default)
# Run `mli-bridge list-devices` to see available device names
AUDIO_DEVICE=

# Playback timing
FPS=30
PRE_ROLL_SECONDS=0.5        # Seconds of lead-in silence before audio starts
PLAYBACK_LOOP_INTERVAL_MS=1 # CueEngine polling interval (ms); lower = more precise

# Show initialisation
SHOW_NAME=MLI_Show
EXECUTOR_PAGE=1
MASTER_FADER=1             # Grandmaster fader number on page 1
SEQUENCE_START_CUE=1.0

# Fixture / group defaults
DEFAULT_DIMMER_FULL=100     # Percent (0-100)
DEFAULT_COLOR_TEMP=5600     # Kelvin for white fixtures
